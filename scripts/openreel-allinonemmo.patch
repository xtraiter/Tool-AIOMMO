@@ -0,0 +1,143 @@
+/**
+ * AIOMMO: import a video straight from a TikTok / YouTube / Facebook… link, using the site's yt-dlp downloader
+ * (/api/download/start → /status → /file, same origin), then hand the file to OpenReel's normal import.
+ */
+import React, { useRef, useState } from "react";
+
+type Props = { onFile: (file: File) => Promise<void> | void };
+
+const QUALITIES = [
+  { h: 720, label: "720p" },
+  { h: 1080, label: "1080p" },
+  { h: 0, label: "Chỉ âm thanh (MP3)" },
+];
+
+function filenameFrom(res: Response, fallback: string): string {
+  const cd = res.headers.get("content-disposition") || "";
+  const star = /filename\*=UTF-8''([^;]+)/i.exec(cd);
+  if (star) { try { return decodeURIComponent(star[1]); } catch { /* fall through */ } }
+  const plain = /filename="?([^";]+)"?/i.exec(cd);
+  return plain ? plain[1] : fallback;
+}
+
+export const LinkImport: React.FC<Props> = ({ onFile }) => {
+  const [open, setOpen] = useState(false);
+  const [url, setUrl] = useState("");
+  const [height, setHeight] = useState(720);
+  const [busy, setBusy] = useState(false);
+  const [pct, setPct] = useState(0);
+  const [status, setStatus] = useState("");
+  const [error, setError] = useState("");
+  const cancelled = useRef(false);
+
+  const run = async () => {
+    const link = url.trim().match(/https?:\/\/\S+/)?.[0];
+    if (!link) { setError("Hãy dán một đường link hợp lệ."); return; }
+    setBusy(true); setError(""); setPct(0); cancelled.current = false;
+    const audio = height === 0;
+    try {
+      setStatus("Đang gửi yêu cầu…");
+      const start = await fetch("/api/download/start", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ url: link, type: audio ? "mp3" : "mp4", height: height || 720, abr: 192 }),
+      });
+      const started = await start.json().catch(() => ({}));
+      if (!start.ok || !started.id) throw new Error(started.error || "Không bắt đầu tải được.");
+
+      setStatus("Đang tải trên máy chủ…");
+      for (;;) {
+        if (cancelled.current) throw new Error("Đã hủy.");
+        await new Promise((r) => setTimeout(r, 1200));
+        const st = await (await fetch(`/api/download/status?id=${encodeURIComponent(started.id)}`)).json();
+        if (st.status === "error") throw new Error(st.error || "Tải thất bại.");
+        setPct(Math.round(st.percent || 0));
+        if (st.stage === "convert") setStatus("Đang ghép hình và tiếng…");
+        if (st.status === "done") break;
+      }
+
+      setStatus("Đang đưa vào dự án…");
+      const res = await fetch(`/api/download/file?id=${encodeURIComponent(started.id)}`);
+      if (!res.ok) throw new Error("Không lấy được tệp đã tải.");
+      const blob = await res.blob();
+      const name = filenameFrom(res, audio ? "audio.mp3" : "video.mp4");
+      await onFile(new File([blob], name, { type: blob.type || (audio ? "audio/mpeg" : "video/mp4") }));
+      setUrl(""); setStatus(""); setOpen(false);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "Tải thất bại.");
+      setStatus("");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  if (!open) {
+    return (
+      <button
+        type="button"
+        onClick={() => setOpen(true)}
+        className="mb-[14px] flex w-full items-center justify-center gap-[7px] rounded-[9px] border border-dashed border-border bg-bg p-[9px] text-[12.5px] font-medium text-fg-2 hover:border-accent hover:text-fg"
+        data-no-translate
+      >
+        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden>
+          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
+          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
+        </svg>
+        Nhập từ link (TikTok, YouTube, Facebook…)
+      </button>
+    );
+  }
+
+  return (
+    <div className="mb-[14px] space-y-2 rounded-[9px] border border-border bg-bg p-[10px]" data-no-translate>
+      <input
+        autoFocus
+        value={url}
+        onChange={(e) => setUrl(e.target.value)}
+        onKeyDown={(e) => { if (e.key === "Enter" && !busy) void run(); if (e.key === "Escape" && !busy) setOpen(false); }}
+        placeholder="Dán link video…"
+        disabled={busy}
+        className="h-8 w-full rounded-md border border-border bg-bg-2 px-2 text-[12.5px] text-fg outline-none focus:border-accent"
+      />
+      <div className="flex gap-1">
+        {QUALITIES.map((q) => (
+          <button
+            key={q.h}
+            type="button"
+            disabled={busy}
+            onClick={() => setHeight(q.h)}
+            className={`h-7 flex-1 rounded-md border px-1 text-[11px] ${height === q.h ? "border-accent bg-accent-soft text-fg" : "border-border text-fg-2 hover:bg-hover"}`}
+          >
+            {q.label}
+          </button>
+        ))}
+      </div>
+      {busy && (
+        <div className="space-y-1">
+          <div className="h-1.5 overflow-hidden rounded bg-bg-3">
+            <div className="h-full bg-accent transition-[width]" style={{ width: `${Math.max(4, pct)}%` }} />
+          </div>
+          <div className="text-[11px] text-fg-3">{status} {pct > 0 ? `${pct}%` : ""}</div>
+        </div>
+      )}
+      {error && <div className="text-[11px] text-red-400">{error}</div>}
+      <div className="flex gap-1.5">
+        <button
+          type="button"
+          onClick={() => (busy ? (cancelled.current = true) : setOpen(false))}
+          className="h-8 flex-1 rounded-md border border-border text-[12px] text-fg-2 hover:bg-hover"
+        >
+          Hủy
+        </button>
+        <button
+          type="button"
+          disabled={busy || !url.trim()}
+          onClick={() => void run()}
+          className="h-8 flex-[2] rounded-md bg-accent text-[12px] font-semibold text-accent-fg disabled:opacity-50"
+        >
+          {busy ? "Đang tải…" : "Tải về & nhập"}
+        </button>
+      </div>
+    </div>
+  );
+};
