+/**
+ * AIOMMO: on-demand Google Fonts loading for the ~470 families with Vietnamese glyphs (catalog.ts).
+ * A family's stylesheet (every available weight, italics too) is injected the first time it is used; the font
+ * files themselves are only downloaded for the weights/scripts actually drawn.
+ */
+import { GOOGLE_FONTS, type FontCategory } from "./catalog";
+
+export type FontInfo = { family: string; category: FontCategory; weights: number[]; italic: boolean };
+
+export const FONTS: FontInfo[] = GOOGLE_FONTS.map(([family, category, weights, italic]) => ({
+  family, category, weights: weights.split(",").map(Number), italic: !!italic,
+}));
+const BY_FAMILY = new Map(FONTS.map((f) => [f.family, f]));
+export const isCatalogFont = (family?: string) => !!family && BY_FAMILY.has(family);
+
+const SAMPLE = "Tiếng Việt Aa";
+const enc = (f: string) => encodeURIComponent(f).replace(/%20/g, "+");
+const injected = new Set<string>();
+const loading = new Map<string, Promise<void>>();
+
+function inject(href: string) {
+  if (injected.has(href)) return;
+  injected.add(href);
+  const link = document.createElement("link");
+  link.rel = "stylesheet";
+  link.href = href;
+  link.crossOrigin = "anonymous";
+  document.head.appendChild(link);
+}
+
+/** Loads a catalog family (no-op for other fonts). Resolves once it can be drawn on a canvas. */
+export function loadFont(family: string | undefined, weight: number | string = 400): Promise<void> {
+  const info = family ? BY_FAMILY.get(family) : undefined;
+  if (!info) return Promise.resolve();
+  const key = `${info.family}|${weight}`;
+  const pending = loading.get(key);
+  if (pending) return pending;
+  const tuples = [...info.weights.map((w) => `0,${w}`), ...(info.italic ? info.weights.map((w) => `1,${w}`) : [])];
+  inject(`https://fonts.googleapis.com/css2?family=${enc(info.family)}:ital,wght@${tuples.join(";")}&display=swap`);
+  const p = (async () => {
+    for (let i = 0; i < 30; i++) { // the stylesheet may still be loading
+      const faces = await document.fonts.load(`${weight} 40px "${info.family}"`, SAMPLE).catch(() => [] as FontFace[]);
+      if (faces.length) return;
+      await new Promise((r) => setTimeout(r, 200));
+    }
+  })();
+  loading.set(key, p);
+  return p;
+}
+
+// ---- tiny name-only previews for the picker, under a separate family name so they never shadow the real font
+const previewed = new Set<string>();
+export const previewFamily = (family: string) => `${family}__aiopv`;
+
+export async function loadPreviews(families: string[]): Promise<void> {
+  const todo = families.filter((f) => BY_FAMILY.has(f) && !previewed.has(f));
+  if (!todo.length) return;
+  todo.forEach((f) => previewed.add(f));
+  const text = [...new Set((todo.join("") + SAMPLE).replace(/\s/g, ""))].join("") + " ";
+  try {
+    const res = await fetch(`https://fonts.googleapis.com/css2?${todo.map((f) => `family=${enc(f)}`).join("&")}&text=${encodeURIComponent(text)}&display=block`);
+    if (!res.ok) throw new Error(String(res.status));
+    const css = (await res.text()).replace(/font-family:\s*'([^']+)'/g, (_m, name) => `font-family: '${previewFamily(name)}'`);
+    const style = document.createElement("style");
+    style.textContent = css;
+    document.head.appendChild(style);
+  } catch {
+    todo.forEach((f) => previewed.delete(f));
+  }
+}
+
+/** Walks any object for `fontFamily` (+ `fontWeight`) values and loads the catalog fonts it finds. */
+export function loadFontsUsedIn(root: unknown) {
+  const seen = new Set<unknown>();
+  const visit = (o: unknown, depth: number) => {
+    if (!o || typeof o !== "object" || depth > 12 || seen.has(o)) return;
+    seen.add(o);
+    const rec = o as Record<string, unknown>;
+    if (typeof rec.fontFamily === "string" && BY_FAMILY.has(rec.fontFamily)) {
+      void loadFont(rec.fontFamily, (rec.fontWeight as number | string | undefined) ?? 400);
+    }
+    for (const v of Object.values(rec)) if (v && typeof v === "object") visit(v, depth + 1);
+  };
+  visit(root, 0);
+}
