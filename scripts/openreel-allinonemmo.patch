@@ -0,0 +1,153 @@
+/*
+ * AIOMMO Studio skin for OpenReel — maps OpenReel's design tokens (index.css), the shadcn HSL tokens and the
+ * Astryx neutral theme onto tool.allinonemmo.com's palette (app/globals.css there):
+ *   light = cream #e1dac8 / navy #1f3f60 / gold #c9a968,  dark = deep teal #091e1e / amber #f59e0b.
+ * Unlayered, so it wins over the layered base styles it overrides.
+ */
+@import url("https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap");
+
+:root {
+  --aio-font: "Be Vietnam Pro", "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
+}
+
+/* ---------------------------------------------------------------- light */
+:root,
+[data-theme="light"] {
+  color-scheme: light;
+  --bg: #e9e4d7;
+  --bg-1: #f8f5ec;
+  --bg-2: #efe9dc;
+  --bg-3: #e1dac8;
+  --bg-elev: #fbf9f3;
+  --border: rgb(31 63 96 / 16%);
+  --border-strong: rgb(31 63 96 / 30%);
+  --fg: #1f3f60;
+  --fg-2: #295479;
+  --fg-3: #4b6075;
+  --fg-muted: #7a8a99;
+  --hover: rgb(31 63 96 / 6%);
+  --selected: rgb(201 169 104 / 26%);
+  --shadow-sm: 0 1px 2px rgb(31 63 96 / 8%);
+  --shadow-md: 0 10px 28px rgb(31 63 96 / 14%);
+  --shadow-lg: 0 22px 70px rgb(31 63 96 / 20%);
+  --track-bg: #f1ecdf;
+  --tl-bg: #f8f5ec;
+  --stage-bg: #f3efe4;
+  --screen-bg: #ffffff;
+  --waveform: #3f8f7b;
+  --accent: #c9a968;
+  --accent-strong: #a8853f;
+  --accent-soft: rgb(201 169 104 / 22%);
+  --accent-fg: #1f3f60;
+  --accent-glow: rgb(201 169 104 / 40%);
+
+  --background: 44 32% 93%;
+  --foreground: 210 51% 25%;
+  --card: 45 45% 95%;
+  --card-foreground: 210 51% 25%;
+  --popover: 45 45% 96%;
+  --popover-foreground: 210 51% 25%;
+  --primary: 40 45% 60%;
+  --primary-foreground: 210 51% 25%;
+  --secondary: 43 28% 89%;
+  --secondary-foreground: 210 51% 25%;
+  --muted: 43 28% 89%;
+  --muted-foreground: 210 22% 38%;
+  --accent-hsl: 43 28% 86%;
+  --accent-foreground: 210 51% 25%;
+  --input: 40 20% 80%;
+  --ring: 40 45% 60%;
+}
+
+/* ---------------------------------------------------------------- dark */
+[data-theme="dark"],
+.dark {
+  color-scheme: dark;
+  --bg: #091e1e;
+  --bg-1: #103030;
+  --bg-2: #0c2626;
+  --bg-3: #143b3b;
+  --bg-elev: #143b3b;
+  --border: rgb(255 255 255 / 10%);
+  --border-strong: rgb(255 255 255 / 18%);
+  --fg: #ffffff;
+  --fg-2: #cbd5e1;
+  --fg-3: #94a3b8;
+  --fg-muted: #64748b;
+  --hover: rgb(255 255 255 / 6%);
+  --selected: rgb(245 158 11 / 18%);
+  --shadow-sm: 0 1px 2px rgb(0 0 0 / 35%);
+  --shadow-md: 0 6px 24px rgb(0 0 0 / 40%);
+  --shadow-lg: 0 24px 60px rgb(0 0 0 / 50%);
+  --track-bg: #0b2424;
+  --tl-bg: #071919;
+  --stage-bg: #061616;
+  --screen-bg: #000000;
+  --waveform: rgb(32 201 151 / 85%);
+  --accent: #f59e0b;
+  --accent-strong: #d97706;
+  --accent-soft: rgb(245 158 11 / 18%);
+  --accent-fg: #1a1200;
+  --accent-glow: rgb(245 158 11 / 45%);
+
+  --background: 180 54% 8%;
+  --foreground: 0 0% 100%;
+  --card: 180 50% 13%;
+  --card-foreground: 0 0% 100%;
+  --popover: 180 50% 13%;
+  --popover-foreground: 0 0% 100%;
+  --primary: 38 92% 50%;
+  --primary-foreground: 40 100% 5%;
+  --secondary: 180 52% 10%;
+  --secondary-foreground: 0 0% 100%;
+  --muted: 180 52% 10%;
+  --muted-foreground: 215 20% 65%;
+  --accent-hsl: 180 46% 16%;
+  --accent-foreground: 0 0% 100%;
+  --input: 180 40% 20%;
+  --ring: 38 92% 50%;
+}
+
+/* ---------------------------------------------------------------- Astryx components */
+[data-astryx-theme] {
+  --font-family-body: var(--aio-font);
+  --font-family-heading: var(--aio-font);
+  --color-background-body: var(--bg);
+  --color-background-card: var(--bg-1);
+  --color-background-surface: var(--bg-elev);
+  --color-background-popover: var(--bg-elev);
+  --color-background-muted: var(--bg-2);
+  --color-accent: var(--accent);
+  --color-accent-muted: var(--accent-soft);
+  --color-on-accent: var(--accent-fg);
+  --color-text-primary: var(--fg);
+  --color-text-secondary: var(--fg-3);
+  --color-text-accent: var(--accent-strong);
+  --color-icon-primary: var(--fg-2);
+  --color-icon-accent: var(--accent);
+  --color-border: var(--border);
+  --color-border-emphasized: var(--border-strong);
+}
+
+/* ---------------------------------------------------------------- type */
+:root,
+body {
+  font-family: var(--aio-font);
+  letter-spacing: 0;
+}
+
+/* ---------------------------------------------------------------- back-to-site pill */
+.aio-back {
+  position: fixed; z-index: 2147483000; top: 12px; left: 12px;
+  display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 12px 0 8px;
+  border: 1px solid var(--border-strong); border-radius: 999px;
+  background: color-mix(in srgb, var(--bg-1) 88%, transparent); backdrop-filter: blur(8px);
+  color: var(--fg); font: 600 12.5px/1 var(--aio-font); text-decoration: none; box-shadow: var(--shadow-sm);
+}
+.aio-back:hover { border-color: var(--accent); color: var(--accent-strong); }
+.aio-back::before { content: "←"; font-weight: 700; margin-right: 1px; }
+.aio-back img { border-radius: 50%; }
+@media (max-width: 767px) {
+  .aio-back { top: auto; bottom: 74px; left: 10px; height: 34px; padding: 0 10px; }
+  .aio-back span { display: none; }
+}
