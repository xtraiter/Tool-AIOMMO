index 0000000..a6d0303
--- /dev/null
+++ b/apps/web/src/aiommo/i18n/translate.ts
@@ -0,0 +1,188 @@
+/**
+ * Vietnamese UI for OpenReel without touching its ~215 component files: a dictionary (vi.json, generated from
+ * the source strings) applied to rendered text nodes and a few attributes, kept up to date by a
+ * MutationObserver. React keeps owning the DOM — when it rewrites a node with English, we translate it again.
+ * Strings that aren't in the dictionary stay English and are collected in window.__aioMissing for review.
+ */
+import VI from "./vi.json";
+
+const DICT = VI as Record<string, string>;
+const ATTRS = ["title", "placeholder", "aria-label", "alt"] as const;
+const SKIP_TAGS = new Set(["SCRIPT", "STYLE", "TEXTAREA", "CODE", "PRE", "NOSCRIPT"]);
+
+/** Templated strings: `$1` etc. are translated recursively when they are dictionary words themselves. */
+const PATTERNS: Array<[RegExp, string]> = [
+  [/^(.+)\. Drag onto a clip to apply, or double-click to apply to selected clip\.$/, "$1. Kéo thả vào clip, hoặc bấm đúp để áp dụng cho clip đã chọn."],
+  [/^(.+)\. Drag onto a clip edge, or double-click to apply to the selected cut\.$/, "$1. Kéo thả vào mép clip, hoặc bấm đúp để áp dụng cho điểm cắt đã chọn."],
+  [/^Expand (.+) section$/, "Mở mục $1"],
+  [/^Collapse (.+) section$/, "Thu gọn mục $1"],
+  [/^Edit (.+) value$/, "Chỉnh giá trị $1"],
+  [/^Edit slider value$/, "Chỉnh giá trị"],
+  [/^Nudge (left|right|up|down) 1 pixel$/, "Dịch $1 1 điểm ảnh"],
+  [/^Directional (left|right|up|down) reveal$/, "Hiện ra theo hướng $1"],
+  [/^Slide the next clip (left|right|up|down)$/, "Trượt clip kế tiếp $1"],
+  [/^Both clips travel (left|right|up|down)$/, "Cả hai clip cùng di chuyển $1"],
+  [/^Motion-blurred whip (left|right|up|down)$/, "Lia vụt có nhòe $1"],
+  [/^Fold the outgoing shot toward the (left|right)$/, "Gập cảnh trước $1"],
+  [/^Card-style (horizontal|vertical) flip between shots$/, "Lật kiểu thẻ $1 giữa hai cảnh"],
+  [/^(.+) \(YouTube, Twitter\)$/, "$1 (YouTube, Twitter)"],
+  [/^Move (.+)$/, "Di chuyển $1"],
+  [/^New (Horizontal|Vertical|Square) Video$/, "Video $1 mới"],
+  [/^Create (Horizontal|Vertical|Square) project$/, "Tạo dự án $1"],
+  [/^Importing (.+) \((\d+)\/(\d+)\)\.\.\.$/, "Đang nhập $1 ($2/$3)..."],
+  [/^Go to step (\d+)$/, "Tới bước $1"],
+  [/^Loop (\S+) to (\S+) • I: mark start • O: mark end • Shift\+L: toggle$/, "Lặp $1 đến $2 • I: đặt điểm đầu • O: đặt điểm cuối • Shift+L: bật/tắt"],
+  [/^Theme: (\w+)\. Switch to (\w+)$/, "Giao diện: $1. Chuyển sang $2"],
+  [/^Download (.+)$/, "Tải $1"],
+  [/^Transcribing with (.+)…$/, "Đang nhận dạng bằng $1…"],
+  [/^Downloading (.+), then transcribing…$/, "Đang tải $1, sau đó nhận dạng…"],
+  [/^Add (\d+) as Editable Text$/, "Thêm $1 dòng thành chữ chỉnh sửa được"],
+  [/^Sync (\d+) Clips to Beats$/, "Khớp $1 clip theo nhịp"],
+  [/^Select all captions \((\d+)\)$/, "Chọn mọi phụ đề ($1)"],
+  [/^Undo \((\d+)\)$/, "Hoàn tác ($1)"],
+  [/^Stack \((\d+)\)$/, "Chuỗi ($1)"],
+  [/^Variables \((\d+)\)$/, "Biến ($1)"],
+  [/^Applied \((\d+)\)$/, "Đã áp dụng ($1)"],
+  [/^(\d+) options?$/, "$1 lựa chọn"],
+  [/^(\d+) clips?$/, "$1 clip"],
+  [/^(\d+) selected$/, "Đã chọn $1"],
+  [/^(\d+) weights?$/, "$1 độ đậm"],
+  [/^Track (\d+)$/, "Rãnh $1"],
+  [/^Video (\d+)$/, "Video $1"],
+  [/^Audio (\d+)$/, "Âm thanh $1"],
+  [/^Text (\d+)$/, "Chữ $1"],
+  [/^Beat (\d+)$/, "Nhịp $1"],
+  [/^Scene (\d+)$/, "Cảnh $1"],
+  [/^Layer (\d+)$/, "Lớp $1"],
+  [/^Track Point (\d+)$/, "Điểm bám $1"],
+  [/^Added to (.+)$/, "Đã thêm vào $1"],
+  [/^Apply (.+)$/, "Áp dụng $1"],
+  [/^Add (.+)$/, "Thêm $1"],
+  [/^Select (.+)$/, "Chọn $1"],
+  [/^Rename (.+)$/, "Đổi tên $1"],
+  [/^Remove (.+)$/, "Gỡ $1"],
+  [/^Use (.+)$/, "Dùng $1"],
+  [/^Search (.+)$/, "Tìm $1"],
+  [/^Solo (.+)$/, "Nghe riêng $1"],
+  [/^Mute (.+)$/, "Tắt tiếng $1"],
+  [/^Unmute (.+)$/, "Bật tiếng $1"],
+  [/^Trim start of (.+)$/, "Cắt đầu $1"],
+  [/^Trim end of (.+)$/, "Cắt cuối $1"],
+  [/^Set (.+) to (.+)$/, "Đặt $1 thành $2"],
+  [/^Seek to (.+)$/, "Tới $1"],
+  [/^Validation error: (.+)$/, "Lỗi kiểm tra: $1"],
+  [/^Saved (\d+) (second|minute|hour)s? ago$/, "Đã lưu $1 $2 trước"],
+  [/^(.+) Voice$/, "Giọng $1"],
+];
+const UNITS: Record<string, string> = {
+  second: "giây", minute: "phút", hour: "giờ",
+  Horizontal: "ngang", Vertical: "dọc", Square: "vuông", horizontal: "ngang", vertical: "dọc",
+  left: "sang trái", right: "sang phải", up: "lên", down: "xuống", Dark: "Tối", Light: "Sáng", System: "Theo hệ thống",
+};
+
+const TRANSLATED = new Set(Object.values(DICT));
+const cache = new Map<string, string | null>();
+const missing = new Set<string>();
+(window as unknown as { __aioMissing: Set<string> }).__aioMissing = missing;
+
+function lookup(core: string): string | undefined {
+  const hit = DICT[core];
+  if (hit !== undefined) return hit;
+  // Same string with a trailing ellipsis / colon / period that the dictionary lacks (or has).
+  const m = /^(.*?)(\.\.\.|…|:|\.)$/.exec(core);
+  if (m && DICT[m[1]] !== undefined) return DICT[m[1]] + m[2];
+  for (const end of ["...", "…", ":"]) if (DICT[core + end] !== undefined) return DICT[core + end].replace(/(\.\.\.|…|:)$/, "");
+  return undefined;
+}
+
+function translateCore(core: string, depth = 0): string | undefined {
+  const direct = lookup(core);
+  if (direct !== undefined) return direct;
+  // Leading icon/emoji or symbols ("🔒 Locked", "+ Add track").
+  const lead = /^([^A-Za-z]+)([A-Za-z].*)$/u.exec(core);
+  if (lead && depth === 0) {
+    const rest = translateCore(lead[2], depth + 1);
+    if (rest !== undefined) return lead[1] + rest;
+  }
+  if (depth > 1) return undefined;
+  for (const [re, out] of PATTERNS) {
+    const m = re.exec(core);
+    if (!m) continue;
+    return out.replace(/\$(\d)/g, (_, i: string) => {
+      const part = m[Number(i)] ?? "";
+      return UNITS[part] ?? translateCore(part, depth + 1) ?? lookup(part.charAt(0).toUpperCase() + part.slice(1)) ?? part;
+    });
+  }
+  return undefined;
+}
+
+/** Translates one UI string, keeping its surrounding whitespace. Returns null when nothing applies. */
+export function translate(text: string): string | null {
+  if (!/[A-Za-z]{2}/.test(text)) return null; // timecodes, numbers, Vietnamese already
+  const cached = cache.get(text);
+  if (cached !== undefined) return cached;
+  const core = text.trim();
+  let result: string | null = null;
+  if (core && /[A-Za-z]/.test(core)) {
+    const t = translateCore(core);
+    if (t !== undefined && t !== core) result = text.replace(core, t);
+    else if (t === undefined && /^[\x20-\x7E…’—–•]+$/.test(core) && /^[A-Z]/.test(core) && !TRANSLATED.has(core) && missing.size < 5000) missing.add(core);
+  }
+  if (cache.size > 20000) cache.clear();
+  cache.set(text, result);
+  return result;
+}
+
+function skip(el: Element | null): boolean {
+  for (let e = el; e; e = e.parentElement) {
+    if (SKIP_TAGS.has(e.tagName) || (e as HTMLElement).isContentEditable || e.hasAttribute("data-no-translate")) return true;
+  }
+  return false;
+}
+
+function translateText(node: Text) {
+  if (skip(node.parentElement)) return;
+  const t = translate(node.data);
+  if (t !== null && t !== node.data) node.data = t;
+}
+
+function translateAttrs(el: Element) {
+  for (const a of ATTRS) {
+    const v = el.getAttribute(a);
+    if (!v) continue;
+    const t = translate(v);
+    if (t !== null && t !== v) el.setAttribute(a, t);
+  }
+  // Read-only inputs used as buttons/values (e.g. <input type="button" value="…">).
+  if (el instanceof HTMLInputElement && (el.type === "button" || el.type === "submit") && el.value) {
+    const t = translate(el.value);
+    if (t !== null) el.value = t;
+  }
+}
+
+function walk(root: Node) {
+  if (root.nodeType === Node.TEXT_NODE) { translateText(root as Text); return; }
+  if (!(root instanceof Element) && !(root instanceof DocumentFragment)) return;
+  if (root instanceof Element) { if (skip(root)) return; translateAttrs(root); }
+  const tw = document.createTreeWalker(root, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT, {
+    acceptNode: (n) => (n instanceof Element && SKIP_TAGS.has(n.tagName) ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT),
+  });
+  for (let n = tw.nextNode(); n; n = tw.nextNode()) {
+    if (n.nodeType === Node.TEXT_NODE) translateText(n as Text);
+    else translateAttrs(n as Element);
+  }
+}
+
+export function startTranslation(root: HTMLElement = document.body) {
+  document.documentElement.lang = "vi";
+  walk(root);
+  const obs = new MutationObserver((records) => {
+    for (const r of records) {
+      if (r.type === "characterData") translateText(r.target as Text);
+      else if (r.type === "attributes") translateAttrs(r.target as Element);
+      else r.addedNodes.forEach(walk);
+    }
+  });
+  obs.observe(root, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: [...ATTRS] });
+  return () => obs.disconnect();
+}
