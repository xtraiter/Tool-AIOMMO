+/**
+ * AIOMMO: text-to-speech with the CapCut voices served by tool.allinonemmo.com (/api/audio/tts, same origin),
+ * replacing OpenReel's ElevenLabs panel (which needs a paid user key). Generation, preview, "add to timeline",
+ * "save to media" and download reuse OpenReel's own useTtsActions hook.
+ */
+import React, { useEffect, useMemo, useState } from "react";
+import { Loader2, Volume2, AlertTriangle } from "@/icons/lucide-compat";
+import { ToolcraftButton as Button, ToolcraftCard as Card, ToolcraftText as Text, ToolcraftTextAreaControl } from "@openreel/ui";
+import { useTtsActions } from "../components/editor/inspector/hooks/useTtsActions";
+import { AudioResult } from "../components/editor/inspector/AudioResult";
+import type { ElevenLabsVoice } from "../components/editor/inspector/tts-types";
+
+type CapCutVoice = { id: string; resourceId?: string; name: string; lang: string; langEn: string; gender: string; tag: string; icon?: string };
+
+const MAX_CHARS = 3000;
+const SPEEDS = [0.8, 0.9, 1, 1.1, 1.2, 1.5];
+
+async function synthesize(text: string, voice: CapCutVoice, speed: number, signal?: AbortSignal): Promise<Blob> {
+  const res = await fetch("/api/audio/tts", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ text, voiceId: voice.id, resourceId: voice.resourceId, speed }),
+    signal,
+  });
+  if (!res.ok) {
+    const data = await res.json().catch(() => ({}) as { error?: string });
+    throw new Error(data.error || "Không tạo được giọng nói. Hãy thử lại.");
+  }
+  return mp3ToWav(await res.arrayBuffer());
+}
+
+/** OpenReel's TTS hook stores the result as a .wav file, so decode CapCut's MP3 and re-wrap it as 16-bit PCM WAV. */
+async function mp3ToWav(data: ArrayBuffer): Promise<Blob> {
+  const ctx = new AudioContext();
+  try {
+    const buf = await ctx.decodeAudioData(data);
+    const ch = buf.numberOfChannels;
+    const frames = buf.length;
+    const out = new DataView(new ArrayBuffer(44 + frames * ch * 2));
+    const str = (o: number, t: string) => { for (let i = 0; i < t.length; i++) out.setUint8(o + i, t.charCodeAt(i)); };
+    str(0, "RIFF"); out.setUint32(4, 36 + frames * ch * 2, true); str(8, "WAVE");
+    str(12, "fmt "); out.setUint32(16, 16, true); out.setUint16(20, 1, true); out.setUint16(22, ch, true);
+    out.setUint32(24, buf.sampleRate, true); out.setUint32(28, buf.sampleRate * ch * 2, true);
+    out.setUint16(32, ch * 2, true); out.setUint16(34, 16, true);
+    str(36, "data"); out.setUint32(40, frames * ch * 2, true);
+    const chans = Array.from({ length: ch }, (_, c) => buf.getChannelData(c));
+    let o = 44;
+    for (let i = 0; i < frames; i++) {
+      for (let c = 0; c < ch; c++) {
+        const v = Math.max(-1, Math.min(1, chans[c][i]));
+        out.setInt16(o, v < 0 ? v * 0x8000 : v * 0x7fff, true);
+        o += 2;
+      }
+    }
+    return new Blob([out.buffer], { type: "audio/wav" });
+  } finally {
+    void ctx.close();
+  }
+}
+
+export const CapCutTtsPanel: React.FC = () => {
+  const [voices, setVoices] = useState<CapCutVoice[]>([]);
+  const [loadError, setLoadError] = useState<string | null>(null);
+  const [lang, setLang] = useState("vi-VN");
+  const [selectedVoice, setSelectedVoice] = useState("");
+  const [speed, setSpeed] = useState(1);
+  const [text, setText] = useState("");
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    let alive = true;
+    fetch("/api/audio/voices")
+      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
+      .then((list: CapCutVoice[]) => {
+        if (!alive) return;
+        setVoices(list);
+        setSelectedVoice((v) => v || list.find((x) => x.lang === "vi-VN")?.id || list[0]?.id || "");
+      })
+      .catch(() => alive && setLoadError("Không tải được danh sách giọng đọc."));
+    return () => { alive = false; };
+  }, []);
+
+  const langs = useMemo(() => {
+    const seen = new Map<string, string>();
+    for (const v of voices) if (!seen.has(v.lang)) seen.set(v.lang, v.lang === "vi-VN" ? "Tiếng Việt" : v.langEn);
+    return [...seen.entries()];
+  }, [voices]);
+  const shown = voices.filter((v) => v.lang === lang);
+  const voiceById = useMemo(() => new Map(voices.map((v) => [v.id, v])), [voices]);
+  // useTtsActions only needs voice_id + name to label the generated clip.
+  const asApiVoices = useMemo(() => voices.map((v) => ({ voice_id: v.id, name: v.name })) as unknown as ElevenLabsVoice[], [voices]);
+
+  const {
+    isGenerating, isPlaying, generatedAudio, hasUnsavedAudio, successMsg, audioRef,
+    getSelectedVoiceName, generateSpeech, togglePlayback, handleAudioEnded, saveToMedia, addToTimeline, downloadAudio,
+  } = useTtsActions({
+    selectedVoice,
+    text,
+    enhanceText: false,
+    enhancedPreview: null,
+    allVoices: asApiVoices,
+    favoriteVoices: [],
+    generateWithElevenLabs: (t, voiceId, signal) => {
+      const voice = voiceById.get(voiceId);
+      if (!voice) return Promise.reject(new Error("Hãy chọn một giọng đọc."));
+      return synthesize(t, voice, speed, signal);
+    },
+    enhanceViaLlm: async (t) => t,
+    setText,
+    setError,
+    setEnhancedPreview: () => {},
+  });
+
+  return (
+    <div className="space-y-3 w-full min-w-0 max-w-full">
+      <audio ref={audioRef as React.RefObject<HTMLAudioElement>} onEnded={handleAudioEnded} className="hidden" />
+
+      <Card variant="green" padding={2} className="border border-primary/30">
+        <Text type="supporting" className="text-[11px] font-semibold">Giọng đọc CapCut · miễn phí</Text>
+        <Text type="supporting" color="secondary" className="block text-[10px]">
+          Hơn {Math.max(10, Math.floor(voices.length / 10) * 10)} giọng, có nhiều giọng tiếng Việt. Tạo xong có thể thêm thẳng vào timeline.
+        </Text>
+      </Card>
+
+      <ToolcraftTextAreaControl
+        label="Văn bản"
+        value={text}
+        onChange={setText}
+        placeholder="Nhập nội dung cần đọc…"
+        maxLength={MAX_CHARS}
+        rows={5}
+        width="100%"
+      />
+      <Text type="supporting" className={`block text-right text-[9px] ${text.length > MAX_CHARS * 0.9 ? "text-red-400" : "text-fg-3"}`}>
+        {text.length}/{MAX_CHARS}
+      </Text>
+
+      <div className="space-y-1.5">
+        <Text type="supporting" color="secondary" className="text-[10px]">Ngôn ngữ</Text>
+        <select
+          className="w-full h-8 rounded-md border border-border bg-bg-2 px-2 text-[12px] text-fg"
+          value={lang}
+          onChange={(e) => {
+            setLang(e.target.value);
+            setSelectedVoice(voices.find((v) => v.lang === e.target.value)?.id || "");
+          }}
+        >
+          {langs.map(([code, name]) => <option key={code} value={code}>{name}</option>)}
+        </select>
+      </div>
+
+      <div className="space-y-1.5">
+        <Text type="supporting" color="secondary" className="text-[10px]">Giọng đọc</Text>
+        <div className="grid grid-cols-2 gap-1.5 max-h-56 overflow-y-auto pr-1">
+          {shown.map((v) => (
+            <button
+              key={v.id}
+              type="button"
+              onClick={() => setSelectedVoice(v.id)}
+              className={`flex items-center gap-1.5 rounded-md border px-2 py-1.5 text-left text-[11px] transition-colors ${
+                v.id === selectedVoice ? "border-accent bg-accent-soft text-fg" : "border-border hover:bg-hover text-fg-2"
+              }`}
+            >
+              <span aria-hidden>{v.icon || (v.gender === "female" ? "👩" : "👨")}</span>
+              <span className="truncate">{v.name}</span>
+            </button>
+          ))}
+          {!voices.length && !loadError && <Text type="supporting" color="secondary" className="text-[10px]">Đang tải giọng đọc…</Text>}
+        </div>
+      </div>
+
+      <div className="space-y-1.5">
+        <Text type="supporting" color="secondary" className="text-[10px]">Tốc độ</Text>
+        <div className="flex flex-wrap gap-1">
+          {SPEEDS.map((s) => (
+            <button
+              key={s}
+              type="button"
+              onClick={() => setSpeed(s)}
+              className={`h-7 min-w-10 rounded-md border px-2 text-[11px] ${s === speed ? "border-accent bg-accent-soft text-fg" : "border-border text-fg-2 hover:bg-hover"}`}
+            >
+              {s}x
+            </button>
+          ))}
+        </div>
+      </div>
+
+      {(error || loadError) && (
+        <Card variant="red" padding={2} className="border border-red-500/30">
+          <Text type="supporting" className="text-[10px] text-red-400">{error || loadError}</Text>
+        </Card>
+      )}
+      {successMsg && (
+        <Card variant="green" padding={2} className="border border-green-500/30">
+          <Text type="supporting" className="text-[10px] text-green-400">{successMsg}</Text>
+        </Card>
+      )}
+
+      <Button
+        label={isGenerating ? "Đang tạo giọng…" : "Tạo giọng đọc"}
+        icon={isGenerating ? <Loader2 size={14} className="animate-spin" aria-hidden /> : <Volume2 size={14} aria-hidden />}
+        variant="primary"
+        size="md"
+        onClick={generateSpeech}
+        isDisabled={isGenerating || !text.trim() || !selectedVoice}
+        isLoading={isGenerating}
+        className="w-full"
+      />
+
+      {hasUnsavedAudio && (
+        <Card variant="yellow" padding={2} className="flex items-center gap-1.5 border border-amber-500/30">
+          <AlertTriangle size={12} className="text-amber-400 shrink-0" aria-hidden />
+          <Text type="supporting" className="text-[9px] text-amber-400">
+            Âm thanh chưa lưu — hãy thêm vào timeline, lưu vào thư viện hoặc tải xuống.
+          </Text>
+        </Card>
+      )}
+
+      {generatedAudio && (
+        <AudioResult
+          generatedAudio={generatedAudio}
+          voiceName={getSelectedVoiceName()}
+          isPlaying={isPlaying}
+          isGenerating={isGenerating}
+          onTogglePlayback={togglePlayback}
+          onSaveToMedia={saveToMedia}
+          onAddToTimeline={addToTimeline}
+          onDownload={downloadAudio}
+        />
+      )}
+    </div>
+  );
+};
+
+export default CapCutTtsPanel;
