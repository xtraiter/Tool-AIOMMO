+/**
+ * AIOMMO: split the selected clip's audio into vocals and instrumental with the same MDX-Net models as the site's
+ * "Tách Lời & Beat" tool (runs in the browser via onnxruntime-web served from /ort/). Each stem is imported as
+ * a WAV and placed on its own new track, aligned with the clip.
+ */
+import React, { useMemo, useRef, useState } from "react";
+import { ToolcraftButton as Button, ToolcraftCard as Card, ToolcraftText as Text } from "@openreel/ui";
+import { useProjectStore } from "../../stores/project-store";
+import { useUIStore } from "../../stores/ui-store";
+import { loadAudioBuffer } from "../../utils/load-audio-buffer";
+import { loadOrt } from "./ort";
+import { loadModelBytes } from "./modelCache";
+import { separateMdx, type MdxParams } from "./mdx";
+
+const UVR = "https://huggingface.co/Blane187/all_public_uvr_models/resolve/main/";
+const TIERS: { id: string; name: string; note: string; url: string; size: number; mdx: MdxParams }[] = [
+  { id: "light", name: "Nhẹ", note: "~30 MB · nhanh, còn lẫn ít nhạc", url: UVR + "UVR_MDXNET_9482.onnx", size: 29_700_000, mdx: { nFft: 6144, dimF: 2048, dimT: 256 } },
+  { id: "balanced", name: "Cân bằng", note: "~67 MB · giọng sạch, hợp làm karaoke", url: UVR + "UVR-MDX-NET-Voc_FT.onnx", size: 66_800_000, mdx: { nFft: 7680, dimF: 3072, dimT: 256 } },
+];
+const SR = 44100;
+
+function toWav(left: Float32Array, right: Float32Array): Blob {
+  const n = left.length;
+  const view = new DataView(new ArrayBuffer(44 + n * 4));
+  const str = (o: number, t: string) => { for (let i = 0; i < t.length; i++) view.setUint8(o + i, t.charCodeAt(i)); };
+  str(0, "RIFF"); view.setUint32(4, 36 + n * 4, true); str(8, "WAVE"); str(12, "fmt ");
+  view.setUint32(16, 16, true); view.setUint16(20, 1, true); view.setUint16(22, 2, true);
+  view.setUint32(24, SR, true); view.setUint32(28, SR * 4, true); view.setUint16(32, 4, true); view.setUint16(34, 16, true);
+  str(36, "data"); view.setUint32(40, n * 4, true);
+  let o = 44;
+  for (let i = 0; i < n; i++) {
+    for (const ch of [left, right]) {
+      const v = Math.max(-1, Math.min(1, ch[i]));
+      view.setInt16(o, v < 0 ? v * 0x8000 : v * 0x7fff, true);
+      o += 2;
+    }
+  }
+  return new Blob([view.buffer], { type: "audio/wav" });
+}
+
+export const SeparationPanel: React.FC = () => {
+  const selectedItems = useUIStore((s) => s.selectedItems);
+  const getClip = useProjectStore((s) => s.getClip);
+  const getMediaItem = useProjectStore((s) => s.getMediaItem);
+  const importMedia = useProjectStore((s) => s.importMedia);
+  const clipId = selectedItems.find((i) => i.type === "clip")?.id ?? "";
+  const clip = getClip(clipId);
+  const media = clip ? getMediaItem(clip.mediaId) : undefined;
+  const usable = !!clip && !!media && (media.type === "video" || media.type === "audio");
+
+  const [tierId, setTierId] = useState("light");
+  const [busy, setBusy] = useState(false);
+  const [pct, setPct] = useState(0);
+  const [status, setStatus] = useState("");
+  const [error, setError] = useState("");
+  const [done, setDone] = useState("");
+  const cancelled = useRef(false);
+  const tier = useMemo(() => TIERS.find((t) => t.id === tierId)!, [tierId]);
+
+  const run = async () => {
+    if (!clip || !media) return;
+    setBusy(true); setError(""); setDone(""); setPct(0); cancelled.current = false;
+    let ctx: AudioContext | null = null;
+    try {
+      setStatus("Đang đọc âm thanh của clip…");
+      const blob = media.blob ?? (media.fileHandle ? await media.fileHandle.getFile() : null);
+      if (!blob) throw new Error("Hãy kết nối lại tệp gốc của clip này.");
+      ctx = new AudioContext({ sampleRate: SR });
+      const buf = await loadAudioBuffer(ctx, blob, { audioTrackIndex: clip.audioTrackIndex });
+      if (!buf) throw new Error("Không giải mã được âm thanh của clip.");
+      const from = Math.max(0, Math.floor((clip.inPoint ?? 0) * SR));
+      const endSec = clip.outPoint > (clip.inPoint ?? 0) ? clip.outPoint : (clip.inPoint ?? 0) + clip.duration * (clip.speed ?? 1);
+      const to = Math.min(buf.length, Math.ceil(endSec * SR));
+      const left = buf.getChannelData(0).slice(from, to);
+      const right = (buf.numberOfChannels > 1 ? buf.getChannelData(1) : buf.getChannelData(0)).slice(from, to);
+      if (left.length < SR / 2) throw new Error("Đoạn âm thanh quá ngắn để tách.");
+
+      setStatus("Đang chuẩn bị thư viện AI…");
+      const ort = await loadOrt();
+      setStatus("Đang tải mô hình (chỉ lần đầu)…");
+      const bytes = await loadModelBytes(tier.url, tier.size, (l, t) => setPct(Math.round((l / t) * 30)));
+      if (cancelled.current) throw new Error("Đã hủy.");
+      setStatus("Đang khởi tạo mô hình…");
+      const webgpu = "gpu" in navigator && !!(await (navigator as unknown as { gpu: { requestAdapter: () => Promise<unknown> } }).gpu.requestAdapter().catch(() => null));
+      const session = await ort.InferenceSession.create(bytes, { executionProviders: webgpu ? ["webgpu", "wasm"] : ["wasm"], graphOptimizationLevel: "all" });
+      setStatus("Đang tách giọng và nhạc nền…");
+      const vocals = await separateMdx({
+        ort, session, left, right, params: tier.mdx,
+        onProgress: (f) => setPct(30 + Math.round(f * 60)),
+        isCancelled: () => cancelled.current,
+      });
+      const beatL = new Float32Array(left.length), beatR = new Float32Array(left.length);
+      for (let i = 0; i < left.length; i++) { beatL[i] = left[i] - vocals.left[i]; beatR[i] = right[i] - vocals.right[i]; }
+
+      setStatus("Đang đưa vào timeline…"); setPct(92);
+      const base = media.name.replace(/\.[^.]+$/, "");
+      for (const [label, l, r] of [["Lời", vocals.left, vocals.right], ["Beat", beatL, beatR]] as const) {
+        const file = new File([toWav(l, r)], `${base} - ${label}.wav`, { type: "audio/wav" });
+        const res = await importMedia(file);
+        if (!res.success || !res.actionId) throw new Error(`Không nhập được bản ${label}.`);
+        await useProjectStore.getState().addClipToNewTrack(res.actionId, clip.startTime);
+      }
+      setPct(100);
+      setDone("Đã thêm 2 rãnh “Lời” và “Beat” ngay dưới vị trí clip. Hãy tắt tiếng clip gốc nếu chỉ muốn nghe bản đã tách.");
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : String(e);
+      setError(msg === "CANCELLED" ? "Đã hủy." : msg);
+    } finally {
+      void ctx?.close();
+      setBusy(false); setStatus("");
+    }
+  };
+
+  return (
+    <div className="space-y-3 w-full min-w-0" data-no-translate>
+      <Card variant="green" padding={2} className="border border-primary/30">
+        <Text type="supporting" className="text-[11px] font-semibold">Tách Lời & Beat bằng AI</Text>
+        <Text type="supporting" color="secondary" className="block text-[10px]">
+          Chọn một clip video/âm thanh trên timeline. Chạy ngay trên máy bạn, không tải tệp lên máy chủ.
+        </Text>
+      </Card>
+
+      <div className="rounded-md border border-border bg-bg-2 px-2.5 py-2 text-[11.5px]">
+        {usable ? <>Clip đang chọn: <b className="text-fg">{media!.name}</b>{(clip!.speed ?? 1) !== 1 && <span className="text-amber-400"> · clip có đổi tốc độ, bản tách sẽ ở tốc độ gốc</span>}</>
+          : <span className="text-fg-3">Chưa chọn clip video hoặc âm thanh nào.</span>}
+      </div>
+
+      <div className="grid grid-cols-2 gap-1.5">
+        {TIERS.map((t) => (
+          <button
+            key={t.id}
+            type="button"
+            disabled={busy}
+            onClick={() => setTierId(t.id)}
+            className={`rounded-md border p-2 text-left ${t.id === tierId ? "border-accent bg-accent-soft" : "border-border hover:bg-hover"}`}
+          >
+            <div className="text-[12px] font-semibold text-fg">{t.name}</div>
+            <div className="text-[10px] text-fg-3">{t.note}</div>
+          </button>
+        ))}
+      </div>
+
+      {busy && (
+        <div className="space-y-1">
+          <div className="h-1.5 overflow-hidden rounded bg-bg-3"><div className="h-full bg-accent transition-[width]" style={{ width: `${Math.max(3, pct)}%` }} /></div>
+          <div className="text-[11px] text-fg-3">{status} {pct}%</div>
+        </div>
+      )}
+      {error && <Card variant="red" padding={2} className="border border-red-500/30"><Text type="supporting" className="text-[10px] text-red-400">{error}</Text></Card>}
+      {done && <Card variant="green" padding={2} className="border border-green-500/30"><Text type="supporting" className="text-[10px] text-green-400">{done}</Text></Card>}
+
+      {busy ? (
+        <Button label="Hủy" variant="secondary" size="md" className="w-full" onClick={() => { cancelled.current = true; }} />
+      ) : (
+        <Button label="Tách Lời & Beat" variant="primary" size="md" className="w-full" onClick={() => void run()} isDisabled={!usable} />
+      )}
+    </div>
+  );
+};
+
+export default SeparationPanel;
