+/**
+ * Glue between OpenReel and tool.allinonemmo.com (same origin):
+ *  - light/dark follows the site's "aio-theme" preference, and changes made here are written back;
+ *  - a small "← AIOMMO Studio" pill links back to the tool hub.
+ */
+import React from "react";
+import ReactDOM from "react-dom/client";
+import { useThemeStore } from "../stores/theme-store";
+import { startTranslation } from "./i18n/translate";
+import { useProjectStore } from "../stores/project-store";
+import { loadFontsUsedIn } from "./fonts/loader";
+import "./theme.css";
+
+const SITE_THEME_KEY = "aio-theme"; // see lib/uiPreferences.ts on the site
+const SITE_HOME = "/";
+
+function readSiteTheme(): "light" | "dark" {
+  try {
+    return localStorage.getItem(SITE_THEME_KEY) === "light" ? "light" : "dark";
+  } catch {
+    return "dark";
+  }
+}
+
+function writeSiteTheme(isDark: boolean) {
+  try {
+    localStorage.setItem(SITE_THEME_KEY, isDark ? "dark" : "light");
+  } catch {
+    /* private mode */
+  }
+}
+
+function syncTheme() {
+  const apply = () => {
+    const wanted = readSiteTheme();
+    if (useThemeStore.getState().mode !== wanted) useThemeStore.getState().setMode(wanted);
+  };
+  // OpenReel's persisted store rehydrates asynchronously; apply after it and on every site-side change.
+  if (useThemeStore.persist.hasHydrated()) apply();
+  useThemeStore.persist.onFinishHydration(apply);
+  window.addEventListener("storage", (e) => { if (e.key === SITE_THEME_KEY) apply(); });
+  useThemeStore.subscribe((state, prev) => { if (state.isDark !== prev.isDark) writeSiteTheme(state.isDark); });
+}
+
+/** Loads every catalog font the open project uses (text clips, captions, motion layers…), throttled. */
+function watchProjectFonts() {
+  let timer = 0;
+  const scan = () => { timer = 0; loadFontsUsedIn(useProjectStore.getState().project); };
+  scan();
+  useProjectStore.subscribe((state, prev) => {
+    if (state.project !== prev.project && !timer) timer = window.setTimeout(scan, 800);
+  });
+}
+
+function BackPill() {
+  return (
+    <a
+      href={SITE_HOME}
+      className="aio-back"
+      title="Quay lại AIOMMO Studio"
+      aria-label="Quay lại AIOMMO Studio"
+    >
+      <img src="/company/logo.png" alt="" width={18} height={18} />
+      <span>AIOMMO Studio</span>
+    </a>
+  );
+}
+
+export function initAiommoBridge() {
+  if (typeof window === "undefined" || window.openreel?.platform === "desktop") return;
+  syncTheme();
+  startTranslation(document.body);
+  watchProjectFonts();
+  document.title = "Trình Dựng Video Pro — AIOMMO Studio";
+  const host = document.createElement("div");
+  host.id = "aio-bridge";
+  document.body.appendChild(host);
+  ReactDOM.createRoot(host).render(<React.StrictMode><BackPill /></React.StrictMode>);
+}
