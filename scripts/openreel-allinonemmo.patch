+/**
+ * AIOMMO: searchable font picker (≈470 Google Fonts with Vietnamese glyphs + the user's uploaded fonts),
+ * replacing OpenReel's fixed font dropdown in the Text section.
+ */
+import React, { useEffect, useMemo, useRef, useState } from "react";
+import { FONTS, loadFont, loadPreviews, previewFamily, type FontInfo } from "./loader";
+
+type Cat = "all" | "recent" | FontInfo["category"] | "custom" | "builtin";
+const RECENT_KEY = "aiommo.recentFonts";
+const PAGE = 60;
+const FALLBACK = '"Be Vietnam Pro", system-ui, sans-serif';
+
+const readRecent = (): string[] => {
+  try { return (JSON.parse(localStorage.getItem(RECENT_KEY) || "[]") as unknown[]).filter((x): x is string => typeof x === "string").slice(0, 12); } catch { return []; }
+};
+const pushRecent = (f: string) => {
+  try { localStorage.setItem(RECENT_KEY, JSON.stringify([f, ...readRecent().filter((x) => x !== f)].slice(0, 12))); } catch { /* private mode */ }
+};
+
+const CATS: { id: Cat; label: string }[] = [
+  { id: "all", label: "Tất cả" },
+  { id: "recent", label: "Gần đây" },
+  { id: "sans", label: "Không chân" },
+  { id: "serif", label: "Có chân" },
+  { id: "display", label: "Tiêu đề" },
+  { id: "hand", label: "Viết tay" },
+  { id: "mono", label: "Đơn cách" },
+  { id: "builtin", label: "Có sẵn" },
+  { id: "custom", label: "Của tôi" },
+];
+
+type Row = { family: string; note?: string; preview: string };
+
+export const AioFontPicker: React.FC<{
+  value: string;
+  onChange: (family: string) => void;
+  /** OpenReel's own font list (incl. ones loaded by index.html) and the user's uploads. */
+  builtinFonts: string[];
+  customFonts: string[];
+}> = ({ value, onChange, builtinFonts, customFonts }) => {
+  const [open, setOpen] = useState(false);
+  const [q, setQ] = useState("");
+  const [cat, setCat] = useState<Cat>("all");
+  const [limit, setLimit] = useState(PAGE);
+  const [recent, setRecent] = useState<string[]>([]);
+  const [busy, setBusy] = useState<string | null>(null);
+  const rootRef = useRef<HTMLDivElement>(null);
+  const listRef = useRef<HTMLDivElement>(null);
+
+  const rows = useMemo<Row[]>(() => {
+    const google = (f: FontInfo): Row => ({ family: f.family, note: f.weights.length > 1 ? `${f.weights.length} độ đậm` : undefined, preview: `"${previewFamily(f.family)}", ${FALLBACK}` });
+    const plain = (family: string, note?: string): Row => ({ family, note, preview: `"${family}", ${FALLBACK}` });
+    let out: Row[];
+    if (cat === "custom") out = customFonts.map((f) => plain(f, "tải lên"));
+    else if (cat === "builtin") out = builtinFonts.map((f) => plain(f));
+    else if (cat === "recent") out = recent.map((f) => FONTS.find((x) => x.family === f) ? google(FONTS.find((x) => x.family === f)!) : plain(f));
+    else out = [...(cat === "all" ? customFonts.map((f) => plain(f, "tải lên")) : []), ...FONTS.filter((f) => cat === "all" || f.category === cat).map(google)];
+    const needle = q.trim().toLowerCase();
+    return needle ? out.filter((r) => r.family.toLowerCase().includes(needle)) : out;
+  }, [cat, q, recent, customFonts, builtinFonts]);
+
+  const refilter = (fn: () => void) => { fn(); setLimit(PAGE); listRef.current?.scrollTo({ top: 0 }); };
+
+  // Name previews for rows that scroll into view, in batches.
+  useEffect(() => {
+    const root = listRef.current;
+    if (!open || !root) return;
+    let pending: string[] = [];
+    let timer = 0;
+    const io = new IntersectionObserver((entries) => {
+      for (const e of entries) if (e.isIntersecting) pending.push((e.target as HTMLElement).dataset.family!);
+      clearTimeout(timer);
+      timer = window.setTimeout(() => {
+        const batch = pending; pending = [];
+        for (let i = 0; i < batch.length; i += 25) void loadPreviews(batch.slice(i, i + 25));
+      }, 60);
+    }, { root, rootMargin: "200px 0px" });
+    root.querySelectorAll<HTMLElement>("[data-family]").forEach((el) => io.observe(el));
+    return () => { io.disconnect(); clearTimeout(timer); };
+  }, [open, rows, limit]);
+
+  useEffect(() => {
+    if (!open) return;
+    const onDown = (e: PointerEvent) => { if (!rootRef.current?.contains(e.target as Node)) setOpen(false); };
+    const onKey = (e: KeyboardEvent) => { if (e.key === "Escape") setOpen(false); };
+    document.addEventListener("pointerdown", onDown);
+    document.addEventListener("keydown", onKey);
+    return () => { document.removeEventListener("pointerdown", onDown); document.removeEventListener("keydown", onKey); };
+  }, [open]);
+
+  useEffect(() => { void loadPreviews([value]); }, [value]);
+
+  const choose = async (family: string) => {
+    setBusy(family);
+    await loadFont(family); // load first so the preview redraws with the real font
+    setBusy(null);
+    pushRecent(family);
+    onChange(family);
+    setOpen(false);
+  };
+
+  return (
+    <div ref={rootRef} className="relative" data-no-translate>
+      <div className="mb-1 text-[10px] text-fg-3">Phông chữ</div>
+      <button
+        type="button"
+        onClick={() => { if (!open) setRecent(readRecent()); setOpen(!open); }}
+        aria-expanded={open}
+        data-aio="font-picker"
+        className={`flex h-9 w-full items-center justify-between gap-2 rounded-md border bg-bg-2 px-2.5 text-left text-[14px] text-fg ${open ? "border-accent" : "border-border"}`}
+      >
+        <span className="truncate" style={{ fontFamily: `"${previewFamily(value)}", "${value}", ${FALLBACK}` }}>{value || "Chọn phông chữ"}</span>
+        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden><path d="m6 9 6 6 6-6" /></svg>
+      </button>
+
+      {open && (
+        <div className="mt-1.5 overflow-hidden rounded-lg border border-border bg-bg-elev shadow-lg">
+          <input
+            autoFocus
+            value={q}
+            onChange={(e) => { const v = e.target.value; refilter(() => setQ(v)); }}
+            placeholder={`Tìm trong ${FONTS.length + builtinFonts.length + customFonts.length} phông chữ…`}
+            className="h-9 w-full border-b border-border bg-transparent px-2.5 text-[12.5px] text-fg outline-none"
+          />
+          <div className="flex gap-1 overflow-x-auto border-b border-border p-1.5 scrollbar-none">
+            {CATS.map((c) => (
+              <button
+                key={c.id}
+                type="button"
+                onClick={() => refilter(() => setCat(c.id))}
+                className={`h-6 shrink-0 rounded-full border px-2 text-[10.5px] font-semibold ${cat === c.id ? "border-accent bg-accent-soft text-fg" : "border-border text-fg-3 hover:text-fg"}`}
+              >
+                {c.label}
+              </button>
+            ))}
+          </div>
+          <div
+            ref={listRef}
+            className="max-h-72 overflow-y-auto overscroll-contain p-1"
+            onScroll={(e) => {
+              const el = e.currentTarget;
+              if (el.scrollTop + el.clientHeight > el.scrollHeight - 300 && limit < rows.length) setLimit((l) => l + PAGE);
+            }}
+          >
+            {rows.slice(0, limit).map((r) => (
+              <button
+                key={r.family}
+                type="button"
+                data-family={r.family}
+                onClick={() => void choose(r.family)}
+                className={`flex w-full items-center justify-between gap-2 rounded-md px-2 py-1.5 text-left ${r.family === value ? "bg-accent-soft text-fg" : "text-fg hover:bg-hover"}`}
+              >
+                <span className="truncate text-[16px] leading-snug" style={{ fontFamily: r.preview }}>{r.family}</span>
+                <span className="shrink-0 text-[10px] text-fg-3">{busy === r.family ? "đang tải…" : r.family === value ? "✓" : r.note ?? ""}</span>
+              </button>
+            ))}
+            {rows.length === 0 && (
+              <div className="px-2 py-4 text-center text-[11px] text-fg-3">
+                {cat === "custom" ? "Chưa có phông chữ tải lên. Dùng ô “Tải phông chữ riêng lên” bên dưới." : "Không tìm thấy phông chữ phù hợp."}
+              </div>
+            )}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+};
